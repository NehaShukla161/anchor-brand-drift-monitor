# --- Backblaze B2 (required) ---
# Create an application key at https://secure.backblaze.com/app_keys.htm
B2_KEY_ID=your_key_id_here
B2_APP_KEY=your_application_key_here
B2_BUCKET=BrandBucket2916
# Check your bucket's "Endpoint" field in the B2 console for the exact
# region string (e.g. s3.ca-east-006.backblazeb2.com -> ca-east-006).
B2_REGION=ca-east-006

# --- Genblaze providers (add only the ones you use) ---
# Pick at least 2 so your demo shows real multi-provider orchestration.
GMI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
STABILITY_API_KEY=

# --- App config ---
DRIFT_THRESHOLD=0.75
